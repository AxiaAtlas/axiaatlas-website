# Server-only secret — read in src/app/api/chat/route.ts.
# MUST NOT use the NEXT_PUBLIC_ prefix, or it would be inlined into the
# client bundle and exposed to every visitor's browser.
ANTHROPIC_API_KEY=sk-ant-...

# Public Supabase config (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
